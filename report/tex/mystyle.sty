% Настройка шрифтов и интервалов
\usepackage{setspace}
\onehalfspacing  % Интервал 1.5 везде

% Основной шрифт 12pt
\renewcommand{\normalsize}{\fontsize{12}{14.4}\selectfont}  % 12pt с учетом 1.5 интервала

\usepackage{indentfirst}

% Section 14pt, левый отступ как у абзацев
\usepackage{titlesec}
\setlength{\parindent}{1.25cm}  % Красная строка 1.25 см (как в Word)
\setlength{\parskip}{0pt}

\titleformat{\section}
  {\fontsize{14}{16.8}\bfseries}  % 14pt с 1.5 интервалом, без \filleft
  {\thesection}{1em}{}

\titlespacing*{\section}
  {1.25cm}  % Левый отступ = parindent абзацев
  {*1}     % Верхний отступ перед
  {*1}    % Нижний отступ после

% Subsection 13pt, левый отступ как у абзацев
\titleformat{\subsection}
  {\fontsize{13}{15.6}\bfseries}  % 13pt с 1.5 интервалом, без \filleft
  {\thesubsection}{1em}{}

\titlespacing*{\subsection}
  {1.25cm}  % Левый отступ = parindent абзацев
  {*1}     % Верхний отступ перед
  {*1}    % Нижний отступ после


% Установка базового размера шрифта
\AtBeginDocument{\normalsize}

\AtBeginBibliography{%
  \let\emph\normalfont  % переназначаем \emph на обычный шрифт
  \let\textit\normalfont % переназначаем \textit на обычный шрифт
}
